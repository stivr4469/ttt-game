# LLM Provider (выбери один или используй Ollama для локального запуска)
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI / OpenRouter
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Ollama — self-hosted LLM (используется если нет ANTHROPIC_API_KEY и OPENAI_API_KEY)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_ENDPOINT=http://localhost:4566

# Evidence Tracker API
EVIDENCE_TRACKER_URL=http://localhost:8000

# MDM — Jamf Pro (оставь пустым для fallback на inventory-файл)
JAMF_URL=https://yourcompany.jamfcloud.com
JAMF_USER=api-readonly
JAMF_PASSWORD=

# MDM — Microsoft Intune (Graph API)
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# DocuSign (оставь пустым для mock режима)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
# DOCUSIGN_BASE_URL=https://www.docusign.net/restapi  # prod (по умолчанию demo)

# Jira (оставь пустым для mock режима)
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USER=compliance@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC

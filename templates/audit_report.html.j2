<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SOC 2 Type II Compliance Report &mdash; {{ company_name }}</title>
  <style>
    /* ── Сброс и базовые стили ─────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --color-pass:        #16a34a;
      --color-pass-bg:     #dcfce7;
      --color-pass-text:   #15803d;
      --color-fail:        #dc2626;
      --color-fail-bg:     #fee2e2;
      --color-fail-text:   #b91c1c;
      --color-warn:        #d97706;
      --color-warn-bg:     #fef3c7;
      --color-warn-text:   #b45309;
      --color-bg:          #ffffff;
      --color-surface:     #f8fafc;
      --color-surface-2:   #f1f5f9;
      --color-border:      #e2e8f0;
      --color-text:        #1e293b;
      --color-muted:       #64748b;
      --color-header-bg:   #0f172a;
      --color-header-fg:   #f1f5f9;
      --color-accent:      #1d4ed8;
      --color-critical-bg: #fef2f2;
      --color-critical:    #991b1b;
      --color-high-bg:     #fff7ed;
      --color-high:        #c2410c;
      --color-medium-bg:   #fefce8;
      --color-medium:      #854d0e;
    }

    body {
      font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
      font-size: 13px;
      line-height: 1.55;
      color: var(--color-text);
      background: var(--color-bg);
      padding: 32px 40px;
      max-width: 1100px;
      margin: 0 auto;
    }

    /* ── Обложка ──────────────────────────────────────────────── */
    .report-cover {
      background: var(--color-header-bg);
      color: var(--color-header-fg);
      border-radius: 10px;
      padding: 40px 48px;
      margin-bottom: 36px;
    }
    .report-cover .company {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #94a3b8;
      margin-bottom: 10px;
    }
    .report-cover h1 {
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 14px;
      line-height: 1.2;
    }
    .report-cover .meta-row {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
      font-size: 12px;
      color: #94a3b8;
    }
    .report-cover .meta-row span strong {
      color: #e2e8f0;
    }

    /* ── Заголовки секций ─────────────────────────────────────── */
    .section-title {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-accent);
      border-bottom: 2px solid var(--color-border);
      padding-bottom: 7px;
      margin-bottom: 20px;
      margin-top: 36px;
    }

    /* ── Executive Summary — карточки ─────────────────────────── */
    .summary-grid {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .summary-card {
      flex: 1;
      min-width: 110px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 20px 18px;
      text-align: center;
    }
    .summary-card .label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-muted);
      margin-bottom: 8px;
    }
    .summary-card .value {
      font-size: 40px;
      font-weight: 800;
      line-height: 1;
    }
    .summary-card.pass  .value { color: var(--color-pass); }
    .summary-card.fail  .value { color: var(--color-fail); }
    .summary-card.ns    .value { color: var(--color-warn); }
    .summary-card.total .value { color: var(--color-text); }
    .summary-card.pct   .value { color: var(--color-accent); font-size: 32px; }

    /* ── Прогресс-бар — CSS только, без картинок ──────────────── */
    .progress-section {
      margin: 20px 0 28px;
    }
    .progress-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .progress-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      width: 80px;
      color: var(--color-muted);
      flex-shrink: 0;
    }
    .progress-bar {
      flex: 1;
      height: 12px;
      background: var(--color-border);
      border-radius: 999px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.3s ease;
    }
    .progress-fill.pass { background: var(--color-pass); }
    .progress-fill.fail { background: var(--color-fail); }
    .progress-value {
      font-size: 11px;
      font-weight: 700;
      width: 42px;
      text-align: right;
      flex-shrink: 0;
      color: var(--color-muted);
    }

    /* Большой бар готовности */
    .readiness-bar-wrap {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 20px 24px;
      margin-bottom: 28px;
    }
    .readiness-bar-label {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 10px;
    }
    .readiness-bar-label .title {
      font-size: 12px;
      font-weight: 600;
      color: var(--color-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .readiness-bar-label .pct {
      font-size: 28px;
      font-weight: 800;
      color: var(--color-pass);
    }
    .readiness-bar {
      height: 16px;
      background: var(--color-border);
      border-radius: 999px;
      overflow: hidden;
    }
    .readiness-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #16a34a, #22c55e);
      border-radius: 999px;
      width: {{ summary.readiness_pct }}%;
    }

    /* ── Таблицы ──────────────────────────────────────────────── */
    .table-wrap {
      overflow-x: auto;
      border-radius: 8px;
      border: 1px solid var(--color-border);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    thead th {
      background: var(--color-header-bg);
      color: var(--color-header-fg);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 10px 14px;
      text-align: left;
      white-space: nowrap;
    }
    tbody tr:nth-child(even) { background: var(--color-surface); }
    tbody tr:hover { background: var(--color-surface-2); }
    tbody td {
      padding: 9px 14px;
      border-bottom: 1px solid var(--color-border);
      vertical-align: top;
    }
    tbody tr:last-child td { border-bottom: none; }

    /* ── Badges ───────────────────────────────────────────────── */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    .badge-pass        { background: var(--color-pass-bg);    color: var(--color-pass-text); }
    .badge-fail        { background: var(--color-fail-bg);    color: var(--color-fail-text); }
    .badge-not_started { background: var(--color-warn-bg);    color: var(--color-warn-text); }
    .badge-pending     { background: var(--color-warn-bg);    color: var(--color-warn-text); }
    .badge-unknown     { background: var(--color-surface-2);  color: var(--color-muted); }
    .badge-critical    { background: var(--color-critical-bg); color: var(--color-critical); }
    .badge-high        { background: var(--color-high-bg);    color: var(--color-high); }
    .badge-medium      { background: var(--color-medium-bg);  color: var(--color-medium); }
    .badge-low         { background: #eff6ff; color: #1d4ed8; }
    .badge-open        { background: var(--color-fail-bg);    color: var(--color-fail-text); }
    .badge-closed      { background: var(--color-pass-bg);    color: var(--color-pass-text); }
    .badge-yes         { background: var(--color-pass-bg);    color: var(--color-pass-text); }
    .badge-no          { background: var(--color-fail-bg);    color: var(--color-fail-text); }
    .badge-tbd         { background: var(--color-surface-2);  color: var(--color-muted); }

    /* ── Finding блоки ────────────────────────────────────────── */
    .finding-block {
      border: 1px solid var(--color-border);
      border-radius: 8px;
      margin-bottom: 16px;
      overflow: hidden;
    }
    .finding-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: var(--color-fail-bg);
      border-bottom: 1px solid #fecaca;
    }
    .finding-header.sev-critical { background: var(--color-critical-bg); border-color: #fca5a5; }
    .finding-header.sev-high     { background: var(--color-high-bg);     border-color: #fdba74; }
    .finding-header.sev-medium   { background: var(--color-medium-bg);   border-color: #fde047; }
    .finding-code {
      font-weight: 800;
      font-size: 13px;
      color: var(--color-accent);
      white-space: nowrap;
    }
    .finding-title {
      font-weight: 600;
      flex: 1;
    }
    .finding-body {
      padding: 14px 16px;
    }
    .finding-body .row {
      margin-bottom: 8px;
      font-size: 12px;
    }
    .finding-body .row:last-child { margin-bottom: 0; }
    .finding-body .lbl {
      font-weight: 700;
      text-transform: uppercase;
      font-size: 10px;
      letter-spacing: 0.06em;
      color: var(--color-muted);
      display: block;
      margin-bottom: 2px;
    }
    .finding-body .txt { color: var(--color-text); }
    .jira-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 600;
      color: var(--color-accent);
      text-decoration: none;
      font-size: 11px;
    }
    .jira-link:hover { text-decoration: underline; }

    /* ── Policy список ────────────────────────────────────────── */
    .policy-list {
      list-style: none;
    }
    .policy-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 12px;
    }
    .policy-list li:last-child { border-bottom: none; }
    .policy-icon {
      font-size: 16px;
      flex-shrink: 0;
      color: var(--color-accent);
    }
    .policy-meta {
      color: var(--color-muted);
      font-size: 11px;
      margin-left: auto;
      white-space: nowrap;
    }

    /* ── Подпись ──────────────────────────────────────────────── */
    .signature-section {
      margin-top: 48px;
      border-top: 2px solid var(--color-border);
      padding-top: 24px;
    }
    .signature-grid {
      display: flex;
      gap: 40px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .signature-box {
      flex: 1;
      min-width: 200px;
    }
    .signature-box .role {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-muted);
      margin-bottom: 40px;
    }
    .signature-line {
      border-bottom: 1px solid var(--color-text);
      margin-bottom: 4px;
    }
    .signature-box .name-label {
      font-size: 10px;
      color: var(--color-muted);
    }

    /* ── Footer ───────────────────────────────────────────────── */
    .report-footer {
      margin-top: 40px;
      border-top: 1px solid var(--color-border);
      padding-top: 14px;
      font-size: 11px;
      color: var(--color-muted);
      text-align: center;
      line-height: 1.8;
    }

    /* ── Утилиты ──────────────────────────────────────────────── */
    .text-muted  { color: var(--color-muted); }
    .text-small  { font-size: 11px; }
    .text-mono   { font-family: 'Courier New', monospace; font-size: 11px; }
    .mt-16       { margin-top: 16px; }
    .mb-0        { margin-bottom: 0; }
    .empty-state {
      padding: 16px;
      color: var(--color-muted);
      font-style: italic;
      font-size: 12px;
    }

    /* ── Стили для печати ─────────────────────────────────────── */
    @media print {
      body {
        padding: 12px 16px;
        font-size: 11px;
        max-width: 100%;
      }
      .report-cover {
        border-radius: 0;
        padding: 28px 32px;
        margin-bottom: 24px;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .section-title { margin-top: 24px; }
      .finding-block  { page-break-inside: avoid; }
      .summary-grid   { page-break-inside: avoid; }
      .readiness-bar-wrap { page-break-inside: avoid; }
      .controls-table-section { page-break-before: always; }
      .findings-section       { page-break-before: always; }
      .vendors-section        { page-break-before: always; }
      .signature-section      { page-break-before: always; }
      /* Сохраняем цвета при печати */
      .badge, .progress-fill, .readiness-bar-fill {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .report-cover, .finding-header, thead th {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      @page {
        margin: 15mm 12mm;
        size: A4;
      }
    }
  </style>
</head>
<body>

{# ── Обложка ──────────────────────────────────────────────────── #}
<div class="report-cover">
  <div class="company">{{ company_name }}</div>
  <h1>SOC 2 Type II Compliance Report</h1>
  <div class="meta-row">
    <span>Generated: <strong>{{ generated_at }}</strong></span>
    <span>Period: <strong>{{ period_start }}</strong> &mdash; <strong>{{ period_end }}</strong></span>
    <span>Controls Assessed: <strong>{{ summary.total }}</strong></span>
    <span>Framework: <strong>AICPA SOC 2 (TSC)</strong></span>
  </div>
</div>

{# ── Executive Summary ────────────────────────────────────────── #}
<div class="section-title">Executive Summary</div>

<div class="summary-grid">
  <div class="summary-card total">
    <div class="label">Controls Assessed</div>
    <div class="value">{{ summary.total }}</div>
  </div>
  <div class="summary-card pass">
    <div class="label">Pass</div>
    <div class="value">{{ summary.pass }}</div>
  </div>
  <div class="summary-card fail">
    <div class="label">Fail</div>
    <div class="value">{{ summary.fail }}</div>
  </div>
  <div class="summary-card ns">
    <div class="label">Not Started</div>
    <div class="value">{{ summary.not_started }}</div>
  </div>
  <div class="summary-card pct">
    <div class="label">Readiness</div>
    <div class="value">{{ summary.readiness_pct }}%</div>
  </div>
</div>

{# Прогресс-бары PASS/FAIL #}
<div class="progress-section">
  <div class="progress-row">
    <span class="progress-label">Pass</span>
    <div class="progress-bar">
      <div class="progress-fill pass" style="width: {{ summary.pass_pct }}%"></div>
    </div>
    <span class="progress-value">{{ summary.pass_pct }}%</span>
  </div>
  <div class="progress-row">
    <span class="progress-label">Fail</span>
    <div class="progress-bar">
      <div class="progress-fill fail" style="width: {{ summary.fail_pct }}%"></div>
    </div>
    <span class="progress-value">{{ summary.fail_pct }}%</span>
  </div>
</div>

{# Большой прогресс-бар общей готовности #}
<div class="readiness-bar-wrap">
  <div class="readiness-bar-label">
    <span class="title">Overall Compliance Readiness</span>
    <span class="pct">{{ summary.readiness_pct }}%</span>
  </div>
  <div class="readiness-bar">
    <div class="readiness-bar-fill"></div>
  </div>
</div>

{# ── Controls Summary Table ───────────────────────────────────── #}
<div class="controls-table-section">
  <div class="section-title">Controls Summary</div>
  {% if controls %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:9%">Code</th>
          <th style="width:38%">Control Name</th>
          <th style="width:18%">Category</th>
          <th style="width:10%">Status</th>
          <th style="width:12%">Evidence</th>
          <th style="width:13%">Notes</th>
        </tr>
      </thead>
      <tbody>
        {% for ctrl in controls %}
        <tr>
          <td><strong>{{ ctrl.code }}</strong></td>
          <td>{{ ctrl.title }}</td>
          <td class="text-muted text-small">{{ ctrl.category if ctrl.category else ctrl.code[:3] }}</td>
          <td>
            {% set s = ctrl.status | lower | replace(' ', '_') %}
            <span class="badge badge-{{ s }}">{{ ctrl.status | upper }}</span>
          </td>
          <td class="text-small">{{ ctrl.evidence | length }} item{{ 's' if ctrl.evidence | length != 1 else '' }}</td>
          <td class="text-small text-muted">
            {% if ctrl.status | upper == 'FAIL' %}
              Requires remediation
            {% elif ctrl.status | upper == 'PASS' %}
              Compliant
            {% else %}
              Pending review
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="empty-state">No controls data. Evidence Tracker may be unavailable.</p>
  {% endif %}
</div>

{# ── Findings ─────────────────────────────────────────────────── #}
<div class="findings-section">
  <div class="section-title">Findings &mdash; Failed Controls</div>
  {% if findings %}
    {% for f in findings %}
    <div class="finding-block">
      <div class="finding-header sev-{{ f.severity | lower }}">
        <span class="badge badge-fail">FAIL</span>
        <span class="finding-code">{{ f.code }}</span>
        <span class="finding-title">{{ f.title }}</span>
        <span class="badge badge-{{ f.severity | lower }}">{{ f.severity }}</span>
        {% if f.jira_key %}
          <a class="jira-link" href="{{ f.jira_url }}" target="_blank">{{ f.jira_key }}</a>
        {% endif %}
      </div>
      <div class="finding-body">
        <div class="row">
          <span class="lbl">Evidence Collected</span>
          <span class="txt">{{ f.evidence_count }} item{{ 's' if f.evidence_count != 1 else '' }}</span>
        </div>
        <div class="row">
          <span class="lbl">Finding</span>
          <span class="txt">{{ f.finding }}</span>
        </div>
        <div class="row">
          <span class="lbl">Remediation Recommendation</span>
          <span class="txt">{{ f.remediation }}</span>
        </div>
        {% if f.jira_key %}
        <div class="row">
          <span class="lbl">Jira Ticket</span>
          <span class="txt">
            <a class="jira-link" href="{{ f.jira_url }}" target="_blank">{{ f.jira_key }}</a>
            &mdash; Priority: <strong>{{ f.priority }}</strong>
          </span>
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  {% else %}
  <p class="empty-state">No findings &mdash; all controls passed.</p>
  {% endif %}
</div>

{# ── Policies ─────────────────────────────────────────────────── #}
<div class="section-title">Governance Policies</div>
{% if policies %}
<ul class="policy-list">
  {% for p in policies %}
  <li>
    <span class="policy-icon">&#128196;</span>
    <span><strong>{{ p.title }}</strong></span>
    <span class="policy-meta">{{ p.filename }} &bull; {{ p.size_kb }} KB &bull; {{ p.created_at }}</span>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty-state">No policy documents found in policies/ directory.</p>
{% endif %}

{# ── Vendors ──────────────────────────────────────────────────── #}
<div class="vendors-section">
  <div class="section-title">Vendor Inventory</div>
  {% if vendors %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Vendor</th>
          <th>Category</th>
          <th>SOC 2 Certified</th>
          <th>Risk Level</th>
          <th>Contract Review</th>
          <th>Data Processed</th>
        </tr>
      </thead>
      <tbody>
        {% for v in vendors %}
        <tr>
          <td><strong>{{ v.name }}</strong></td>
          <td class="text-small text-muted">{{ v.category }}</td>
          <td>
            {% if v.soc2_certified %}
              <span class="badge badge-yes">Yes</span>
            {% else %}
              <span class="badge badge-no">No</span>
            {% endif %}
          </td>
          <td>
            {% set rl = v.risk_level | lower %}
            {% if rl == 'tbd' or rl == '' %}
              <span class="badge badge-tbd">TBD</span>
            {% elif rl in ['high', 'critical'] %}
              <span class="badge badge-{{ rl }}">{{ v.risk_level }}</span>
            {% elif rl == 'medium' %}
              <span class="badge badge-medium">{{ v.risk_level }}</span>
            {% else %}
              <span class="badge badge-low">{{ v.risk_level }}</span>
            {% endif %}
          </td>
          <td class="text-small">{{ v.contract_review_date }}</td>
          <td class="text-small text-muted">{{ v.data_processed }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="empty-state">No vendor inventory data available.</p>
  {% endif %}
</div>

{# ── Remediation Tickets ──────────────────────────────────────── #}
<div class="section-title">Remediation Tickets</div>
{% if remediations %}
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Ticket</th>
        <th>Control</th>
        <th>Finding</th>
        <th>Priority</th>
        <th>Status</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      {% for t in remediations %}
      <tr>
        <td>
          {% if t.jira_url and t.jira_url != '#' %}
            <a class="jira-link" href="{{ t.jira_url }}" target="_blank">{{ t.jira_key }}</a>
          {% else %}
            <span class="text-mono">{{ t.jira_key }}</span>
          {% endif %}
          {% if t.is_mock %}<span class="text-muted text-small"> (mock)</span>{% endif %}
        </td>
        <td><strong>{{ t.control_code }}</strong></td>
        <td class="text-small">{{ t.finding }}</td>
        <td>
          {% set p = t.priority | lower %}
          {% if p == 'critical' %}
            <span class="badge badge-critical">{{ t.priority }}</span>
          {% elif p == 'high' %}
            <span class="badge badge-high">{{ t.priority }}</span>
          {% elif p == 'medium' %}
            <span class="badge badge-medium">{{ t.priority }}</span>
          {% else %}
            <span class="badge badge-low">{{ t.priority }}</span>
          {% endif %}
        </td>
        <td>
          {% set st = t.status | lower %}
          {% if st == 'open' %}
            <span class="badge badge-open">OPEN</span>
          {% else %}
            <span class="badge badge-closed">{{ t.status }}</span>
          {% endif %}
        </td>
        <td class="text-small text-muted">{{ t.created_at }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p class="empty-state">No remediation tickets found.</p>
{% endif %}

{# ── Подпись ──────────────────────────────────────────────────── #}
<div class="signature-section">
  <div class="section-title mb-0">Authorization &amp; Signatures</div>
  <div class="signature-grid">
    <div class="signature-box">
      <div class="role">Report Prepared By</div>
      <div class="signature-line"></div>
      <div class="name-label">Compliance Sandbox v1.0 &bull; Automated Report</div>
    </div>
    <div class="signature-box">
      <div class="role">Reviewed By (Auditor)</div>
      <div class="signature-line"></div>
      <div class="name-label">Name / Signature &bull; Date: ___________</div>
    </div>
    <div class="signature-box">
      <div class="role">Approved By (CISO)</div>
      <div class="signature-line"></div>
      <div class="name-label">Name / Signature &bull; Date: ___________</div>
    </div>
  </div>
</div>

{# ── Footer ───────────────────────────────────────────────────── #}
<div class="report-footer">
  <div>Report generated by <strong>Compliance Sandbox v1.0</strong> &bull; {{ company_name }}</div>
  <div>{{ generated_at }} &bull; AICPA SOC 2 Type II Trust Services Criteria</div>
  <div class="text-small" style="margin-top:4px; color:#94a3b8;">
    This report is confidential and intended solely for authorized personnel.
    Distribution to unauthorized parties is prohibited.
  </div>
</div>

</body>
</html>
